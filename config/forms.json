    "Slip House": {
      "forms": [
        {
          "id": "slip_house_parameters",
          "title": "Slip House Parameters - Tirupati",
          "description": "Slip Testing Record",
          "parameters": [
            {
              "id": "operator_name",
              "label": "Name of the operator performing the test",
              "type": "text",
              "required": true,
              "role": "filter"
            },
            {
              "id": "ball_mill_type",
              "label": "Ball Mill Type",
              "type": "choice",
              "required": true,
              "role": "filter",
              "options": [
                "Continuous",
                "Batch Ball Mill"
              ]
            },
            {
              "id": "ball_mill_number",
              "label": "Ball Mill Number",
              "type": "number",
              "required": true,
              "unit": "",
              "role": "filter",
              "chart_type": "none",
              "decimals": 0,
              "show_if": {
                "field": "ball_mill_type",
                "equals": "Batch Ball Mill"
              }
            },
            {
              "id": "batch_number",
              "label": "Batch Number",
              "type": "text",
              "required": true,
              "role": "filter"
            },
            {
              "id": "body_code",
              "label": "Body Code",
              "type": "text",
              "required": true,
              "role": "filter"
            },
            {
              "id": "slip_density",
              "label": "Slip Density (g/cc)",
              "type": "number",
              "required": true,
              "unit": "g/cc",
              "role": "measure",
              "chart_type": "imr",
              "decimals": 3
            },
            {
              "id": "viscosity",
              "label": "Viscosity (Seconds)",
              "type": "number",
              "required": true,
              "unit": "Seconds",
              "role": "measure",
              "chart_type": "imr",
              "decimals": 3
            },
            {
              "id": "residue_240",
              "label": "Residue % (#240)",
              "type": "number",
              "required": true,
              "unit": "%",
              "role": "measure",
              "chart_type": "imr",
              "decimals": 3
            },
            {
              "id": "psa_d50",
              "label": "Particle size analysis (PSA-D50) - (microns)",
              "type": "number",
              "required": false,
              "unit": "microns",
              "role": "measure",
              "chart_type": "imr",
              "decimals": 3
            },
            {
              "id": "remarks",
              "label": "Remarks (Comments if any)",
              "type": "textarea",
              "required": false,
              "role": "note"
            }
          ]
        }
      ]
    },
